---
import '@fontsource-variable/geologica';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import geologicaLatin from '@fontsource-variable/geologica/files/geologica-latin-wght-normal.woff2?url';
import { person, verification } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// The link-preview card, rendered by scripts/make-og.mjs.
const ogImage = new URL('/og.png', Astro.site);
const ogAlt = `${person.name} (${person.cjk}): ${person.role}`;
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={person.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {verification.google && <meta name="google-site-verification" content={verification.google} />}
    {verification.bing && <meta name="msvalidate.01" content={verification.bing} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="profile:first_name" content={person.given} />
    <meta property="profile:last_name" content={person.family} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <slot name="head" />
    {/* The name is set in Geologica: fetch it with the page. Until it lands, the metric-matched stand-in holds its place. */}
    <link rel="preload" href={geologicaLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cjk/MaShanZheng.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.dataset.theme = t;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('still');
      })();
    </script>
    {isProd && (
      <script
        is:inline
        data-goatcounter="https://cxh42.goatcounter.com/count"
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <a class="skip" href="#research">Skip to content</a>
    <slot />
  </body>
</html>
