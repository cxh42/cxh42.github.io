---
import { interests, publications } from '../data/site';
const paper = publications[0];
---

<section class="section" id="research" aria-labelledby="research-title">
  <div class="wrap section-grid">
    <h2 class="section-title" id="research-title">Research</h2>
    <div class="section-body">
      <p class="thesis">I am a <em>generative AI</em> researcher, currently working on video generation.</p>

      <p class="lead">
        My research interests include video generation, large language models (LLMs) and vision-language models
        (VLMs), and 3D Gaussian Splatting (3DGS). My recent work, {paper.title.split(':')[0]}, introduces a benchmark
        and a 14B reference model for high-fidelity video scene text editing and appears at {paper.venue}. In Spring
        2027 I will start my Ph.D. in Computer Science at Texas A&amp;M University, advised by Dr. Zhengzhong Tu.
      </p>

      <h3 class="interests-title">Research interests</h3>
      <ul class="interests">
        {interests.map((a) => (
          <li>
            <span class="name">{a.name}</span>
            {a.note && <span class="note">{a.note}</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .thesis {
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.028em;
    font-weight: 320;
    max-width: 22ch;
  }
  .thesis em {
    font-style: normal;
    font-weight: 450;
  }
  .lead {
    margin-top: clamp(24px, 3vw, 36px);
    color: var(--ink-2);
    max-width: 62ch;
  }
  .interests-title {
    margin-top: clamp(36px, 5vw, 56px);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--graphite);
  }
  .interests {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .interests li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-block: 16px;
    border-bottom: 1px solid var(--rule);
  }
  .name { font-size: var(--step-1); letter-spacing: -0.01em; }
  .note { font-size: var(--step--1); letter-spacing: 0.01em; color: var(--ink); font-weight: 500; white-space: nowrap; }
</style>
