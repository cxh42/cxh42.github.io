---
import { areas } from '../data/site';
---

<section class="section" id="research" aria-labelledby="research-title">
  <div class="wrap section-grid">
    <h2 class="section-title" id="research-title">Research</h2>
    <div class="section-body">
      <p class="thesis">I work on <em>generative AI</em>. Right now that means video generation models.</p>

      <p class="lead">
        Most of my recent work is on video generation. I am also increasingly drawn to large language models and want
        to work on them next. Before video, I worked on vision-language models and on 3D Gaussian Splatting, which took
        me into virtual reality.
      </p>

      <dl class="areas">
        {areas.map((a) => (
          <div class="area">
            <dt>{a.name}</dt>
            <dd class="status">{a.status}</dd>
            {a.note && <dd class="note">{a.note}</dd>}
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .thesis {
    font-size: var(--step-3);
    line-height: 1.12;
    letter-spacing: -0.028em;
    font-weight: 320;
    max-width: 22ch;
  }
  .thesis em {
    font-style: normal;
    font-weight: 450;
  }
  .lead {
    margin-top: clamp(24px, 3vw, 36px);
    color: var(--ink-2);
    max-width: 62ch;
  }

  /* A ledger of areas: name, where it stands, one line on what it is. */
  .areas {
    margin: clamp(36px, 5vw, 56px) 0 0;
    border-top: 1px solid var(--rule);
  }
  .area {
    display: grid;
    grid-template-columns: minmax(12rem, 1.1fr) minmax(8rem, 0.7fr) minmax(0, 1.6fr);
    gap: 4px 24px;
    padding-block: 16px;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .area dt { font-size: var(--step-1); font-weight: 400; letter-spacing: -0.01em; }
  .area dd { margin: 0; }
  .status { font-size: var(--step--1); letter-spacing: 0.01em; color: var(--graphite); }
  .area:first-child .status { color: var(--ink); font-weight: 500; }
  .note { color: var(--ink-2); font-size: 0.9375rem; }

  @media (max-width: 760px) {
    .area { grid-template-columns: 1fr auto; }
    .note { grid-column: 1 / -1; }
  }
</style>
