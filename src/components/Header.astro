---
import { person, sections } from '../data/site';
---

<header class="bar" data-bar>
  <div class="bar-inner">
    <a class="wordmark" href="#top" aria-label={`${person.name}, back to top`}>{person.name}</a>

    <div class="bar-end">
      <a class="bar-mail" href={`mailto:${person.email}`}>Email</a>

      <div class="theme" role="group" aria-label="Colour theme">
        <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
        <span class="theme-sep" aria-hidden="true"></span>
        <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
      </div>

      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="menu-label">Menu</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
          <path class="i-open" d="M2 5.5h12M2 10.5h12" />
          <path class="i-close" d="M3 3l10 10M13 3 3 13" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="menu" id="menu" aria-label="Sections" data-menu hidden>
    <ul>
      {sections.map((s) => (
        <li><a href={`#${s.id}`}>{s.label}</a></li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: var(--header-h);
    color: var(--ink);
    transition: background-color 240ms var(--ease-out), box-shadow 240ms var(--ease-out);
  }
  :global(html.scrolled) .bar {
    background: var(--plate);
    box-shadow: 0 1px 0 var(--rule);
  }
  .bar-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-inline: var(--gutter);
    max-width: calc(1360px + var(--rail-space) + 2 * var(--gutter));
    margin-inline: auto;
  }
  .wordmark {
    font-size: 0.9375rem;
    font-weight: 450;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: opacity 300ms var(--ease-out);
  }
  :global(html.js:not(.past-hero)) .wordmark {
    opacity: 0;
    pointer-events: none;
  }
  .bar-end {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 32px);
    font-size: var(--step--1);
  }
  .bar-mail { text-decoration: none; letter-spacing: 0.01em; }
  .bar-mail:hover { text-decoration: underline; text-decoration-color: currentColor; }

  .theme {
    display: flex;
    align-items: center;
    gap: 10px;
    letter-spacing: 0.01em;
  }
  .theme button {
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    color: var(--graphite);
    position: relative;
    transition: color 200ms var(--ease-out);
  }
  .theme button:hover { color: var(--ink); }
  .theme button[aria-pressed='true'] { color: var(--ink); }
  .theme button[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 1px;
    background: currentColor;
  }
  .theme-sep { width: 1px; height: 12px; background: var(--rule-strong); }

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    letter-spacing: 0.01em;
  }
  .menu-btn svg { width: 16px; height: 16px; }
  .menu-btn .i-close, .menu-btn[aria-expanded='true'] .i-open { display: none; }
  .menu-btn[aria-expanded='true'] .i-close { display: inline; }

  .menu {
    position: absolute;
    inset: var(--header-h) 0 auto 0;
    background: var(--plate);
    box-shadow: 0 1px 0 var(--rule), 0 18px 32px -24px rgb(0 0 0 / 0.35);
    padding: 8px var(--gutter) 20px;
  }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu a {
    display: block;
    padding: 12px 0;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    text-decoration: none;
    border-bottom: 1px solid var(--rule);
  }
  .menu li:last-child a { border-bottom: 0; }

  @media (min-width: 1100px) {
    .menu-btn, .menu { display: none; }
  }
  @media (max-width: 420px) {
    .bar-end { gap: 14px; }
  }
</style>
