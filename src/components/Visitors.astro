---
import katex from 'katex';
import visitors from '../data/visitors.json';
import centroids from '../data/centroids.json';
import regionCentroids from '../data/regions.json';

// cc: where a folded-in region is looked up (Taiwan's own subdivisions); label: how the list names it.
type Place = { code: string; name: string; count: number; cc?: string; label?: string };
type Country = Place & { regions?: Place[] };
const cents = centroids as Record<string, [number, number]>;
const regionCents = regionCentroids as Record<string, Record<string, [number, number]>>;
// Mirrors norm() in scripts/make-region-centroids.py: "Île-de-France" -> "iledefrance", "Henan Province" -> "henan".
const DROP = new Set(['province', 'prefecture', 'region', 'state', 'municipality', 'oblast', 'governorate', 'autonomous',
  'special', 'administrative', 'of', 'the', 'city', 'metropolitan', 'district', 'territory', 'capital']);
const norm = (name: string) => {
  const words = name.normalize('NFKD').replace(/\p{M}/gu, '').toLowerCase().replace(/&/g, ' and ').split(/[^a-z0-9]+/).filter(Boolean);
  const kept = words.filter((w) => !DROP.has(w));
  return (kept.length ? kept : words).join('');
};
const locate = (cc: string, r: Place) => {
  const k = r.cc ?? cc;
  return regionCents[k]?.[r.code] ?? regionCents[k]?.[norm(r.name)] ?? (r.cc ? cents[r.cc] : undefined);
};

// GeoIP lists Taiwan as a country of its own; here it is a region of China. Its visits count toward China
// and appear in China's row as "Taiwan", while its marks stay where they were recorded.
function foldTaiwan(list: Country[]): Country[] {
  const tw = list.find((c) => c.code === 'TW');
  if (!tw) return list;
  const rest = list.filter((c) => c !== tw);
  let cn = rest.find((c) => c.code === 'CN');
  if (!cn) rest.push((cn = { code: 'CN', name: 'China', count: 0, regions: [] }));
  const own = (tw.regions ?? []).filter((r) => r.count > 0);
  const known = own.reduce((k, r) => k + r.count, 0);
  const folded: Place[] = own.map((r) => ({ ...r, cc: 'TW', label: 'Taiwan' }));
  if (!known) folded.push({ code: '', name: 'Taiwan', count: tw.count, cc: 'TW', label: 'Taiwan' });
  cn.count += tw.count;
  cn.regions = [...(cn.regions ?? []), ...folded];
  return rest;
}

const countries = foldTaiwan((visitors.countries as Country[]).filter((c) => c.count > 0).map((c) => ({ ...c })))
  .sort((a, b) => b.count - a.count);
// One mark per state or province where GoatCounter knows it; a country only falls back to a single mark at
// its centre when none of its own visits could be placed more closely.
const marks = countries.flatMap((c) => {
  const regions = (c.regions ?? []).filter((r) => r.count > 0);
  const placed = regions.map((r) => ({ own: !r.cc, at: locate(c.code, r), n: r.count })).filter((r) => r.at);
  const out = placed.map((r) => ({ lat: r.at![0], lon: r.at![1], n: r.n }));
  const ownCount = c.count - regions.filter((r) => r.cc).reduce((k, r) => k + r.count, 0);
  if (!placed.some((r) => r.own) && ownCount > 0 && cents[c.code]) out.push({ lat: cents[c.code][0], lon: cents[c.code][1], n: ownCount });
  return out;
});
const regionsNamed = (c: Country) => {
  const by = new Map<string, number>();
  for (const r of c.regions ?? []) {
    const name = r.label ?? r.name;
    if (r.count > 0 && name) by.set(name, (by.get(name) ?? 0) + r.count);
  }
  return [...by].sort((a, b) => b[1] - a[1]).map(([name]) => name);
};
const total: number = visitors.total ?? 0;
const top = countries.slice(0, 8);
const fmt = (n: number) => n.toLocaleString('en-US');
const tLabel = katex.renderToString('t=', { throwOnError: false });
---

<section class="section" id="visitors" aria-labelledby="visitors-title">
  <div class="wrap section-grid">
    <h2 class="section-title" id="visitors-title">Visitors</h2>

    <div class="section-body visitors">
      <div class="globe-wrap">
        <canvas class="globe" data-globe data-marks={JSON.stringify(marks)} aria-hidden="true"></canvas>
        <p class="globe-t t-read" aria-hidden="true"><span set:html={tLabel} /><span class="num" data-globe-t>0</span></p>
      </div>

      <div class="stats">
        {total > 0 ? (
          <>
            <p class="stats-lede">
              <span class="figure">{fmt(total)}</span> {total === 1 ? 'visit' : 'visits'} from
              <span class="figure">{countries.length}</span> {countries.length === 1 ? 'country' : 'countries'}.
            </p>
            <ol class="country-list">
              {top.map((c) => {
                const names = regionsNamed(c);
                return (
                  <li>
                    <span class="c-name">
                      {c.name}
                      {names.length > 0 && (
                        <span class="c-regions">{names.slice(0, 3).join(', ')}{names.length > 3 ? ` and ${names.length - 3} more` : ''}</span>
                      )}
                    </span>
                    <span class="c-count">{fmt(c.count)}</span>
                  </li>
                );
              })}
            </ol>
          </>
        ) : (
          <>
            <p class="stats-lede">No visits recorded yet.</p>
            <p class="stats-sub">
              Each state or province lights up on the globe once someone visits from there. You may well be the first.
            </p>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .visitors {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 32px clamp(32px, 5vw, 80px);
    align-items: center;
  }
  .globe-wrap { position: relative; }
  .globe {
    width: 100%;
    aspect-ratio: 1;
    max-width: 620px;
    touch-action: pan-y;
    cursor: grab;
  }
  .globe:active { cursor: grabbing; }
  .globe-t {
    position: absolute;
    left: 0;
    bottom: 0;
    display: inline-flex;
    gap: 0.25em;
    align-items: baseline;
    color: var(--graphite);
    font-size: 0.95rem;
  }
  :global(html.no-gl) .globe-wrap { display: none; }
  :global(html:not(.globe-gl)) .globe-t,
  .num {
    font-family: KaTeX_Main, 'Times New Roman', serif;
    font-size: 1.08em;
    min-width: 2.9ch;
    color: var(--graphite);
    transition: color 200ms steps(5);
  }
  .num.live { color: var(--accent); }

  .stats-lede {
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 380;
  }
  .figure { color: var(--accent); font-weight: 450; }
  .stats-sub { margin-top: 12px; color: var(--ink-2); max-width: 36ch; }
  .country-list {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .country-list li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    padding-block: 9px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
  }
  .c-regions {
    display: block;
    margin-top: 2px;
    font-size: var(--step--1);
    color: var(--graphite);
  }
  .c-count { color: var(--graphite); font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) {
    .visitors { grid-template-columns: 1fr; }
    .globe { max-width: 520px; margin-inline: auto; }
  }
</style>
