---
import { news } from '../data/site';

// News text may carry inline links written as [label](href).
const parts = (text: string) => text.split(/(\[[^\]]+\]\([^)]+\))/).map((seg) => {
  const m = seg.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
  return m ? { label: m[1], href: m[2] } : seg;
});
---

<section class="section" id="news" aria-labelledby="news-title">
  <div class="wrap section-grid">
    <h2 class="section-title" id="news-title">News</h2>
    <ol class="section-body news">
      {news.map((n) => (
        <li class:list={['item', { upcoming: n.upcoming }]}>
          <time class="date" datetime={n.iso}>{n.date}</time>
          <p class="text">
            {parts(n.text).map((x) => (typeof x === 'string' ? x : <a href={x.href}>{x.label}</a>))}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .item {
    display: grid;
    grid-template-columns: minmax(8.5rem, 1fr) minmax(0, 3.2fr);
    gap: 8px 32px;
    padding-block: 22px;
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }
  .date {
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }
  .text {
    font-size: var(--step-1);
    line-height: 1.4;
    letter-spacing: -0.008em;
    max-width: 52ch;
  }
  .upcoming .text { color: var(--ink); }
  @media (max-width: 640px) {
    .item { grid-template-columns: 1fr; }
  }
</style>
