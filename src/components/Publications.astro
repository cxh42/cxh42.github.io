---
import katex from 'katex';
import Arrow from './Arrow.astro';
import { person, publications } from '../data/site';

const tLabel = katex.renderToString('t=', { throwOnError: false });
---

<section class="section" id="publications" aria-labelledby="publications-title">
  <div class="wrap section-grid">
    <div class="section-title pubs-title">
      <h2 id="publications-title">Selected Publications</h2>
    </div>

    <ol class="section-body papers">
      {publications.map((pub) => {
        const st = pub.stage;
        const first = st.scenes[0];
        return (
          <li class="paper">
            <article aria-labelledby={`pub-${pub.id}`}>
              <header class="pub-head">
                <h3 class="pub-title" id={`pub-${pub.id}`}>
                  <span class="pub-name">{pub.short}:</span> {pub.title.slice(pub.short.length + 2).split(/(\S+-\S+)/).map((w) => (/-/.test(w) ? <span class="nw">{w}</span> : w))}
                </h3>
                <p class="authors">
                  {pub.authors.map((a, i) => (<>{a === person.name ? <strong>{a}</strong> : <span>{a}</span>}{i < pub.authors.length - 1 ? ', ' : ''}</>))}
                </p>
                <p class="venue">
                  <span class="venue-badge">{pub.venue}</span>
                  {pub.track && <span class="venue-track">{pub.track}</span>}
                </p>
              </header>

              <figure class="stage-fig" data-stage data-base={st.base}>
                <div class="stage">
                  {st.kind === 'video' ? (
                    <video
                      data-stage-media
                      muted
                      playsinline
                      loop
                      preload="none"
                      poster={`${st.base}/${first.id}.jpg`}
                      src={`${st.base}/${first.id}.mp4`}
                      aria-label={first.alt}
                    ></video>
                  ) : (
                    <img data-stage-media src={`${st.base}/${first.id}.jpg`} alt={first.alt} width="1280" height="360" loading="lazy" decoding="async" />
                  )}
                  <canvas data-stage-canvas aria-hidden="true"></canvas>
                </div>

                <figcaption class="stage-labels meta">
                  <span><span class="lbl-narrow">Top: </span>{st.labels[0]}</span>
                  <span><span class="lbl-narrow">Bottom: </span>{st.labels[1]}</span>
                </figcaption>

                <div class="scenes">
                  <div class="scene-list" role="group" aria-label={`${pub.short} examples`}>
                    {st.scenes.map((sc, i) => (
                      <button type="button" data-scene={sc.id} data-alt={sc.alt} aria-pressed={i === 0 ? 'true' : 'false'}>
                        {sc.op === 'replace' ? (
                          <>
                            <span>{sc.from}</span>
                            <svg class="op op-arrow" viewBox="0 0 14 8" role="img" aria-label="to"><path d="M0 4h12.5M9.5 1l3 3-3 3" /></svg>
                            <span>{sc.to}</span>
                          </>
                        ) : (
                          <>
                            <svg class="op" viewBox="0 0 9 9" role="img" aria-label={sc.op === 'insert' ? 'Insert' : 'Remove'}>
                              <path d={sc.op === 'insert' ? 'M0 4.5h9M4.5 0v9' : 'M0 4.5h9'} />
                            </svg>
                            <span>{sc.to}</span>
                          </>
                        )}
                      </button>
                    ))}
                  </div>
                  <p class="scene-t t-read" aria-hidden="true"><span set:html={tLabel} /><span class="num" data-stage-t>0</span></p>
                </div>
              </figure>

              <div class="pub-foot">
                <p class="summary">{pub.summary}</p>
                <ul class="pub-links">
                  {pub.links.map((l) => (
                    <li>
                      <a class="arrow-link" href={l.href}>
                        {l.label}
                        <Arrow />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .pubs-title h2 { font: inherit; letter-spacing: inherit; }

  /* Each paper is its own unit: a tinted plate with room around it, so the next one reads as a new project. */
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2vw, 24px);
  }
  .paper {
    background: var(--plate-2);
    padding: clamp(16px, 2.6vw, 36px);
  }

  /* The title leads each paper; the venue sits right under it as a badge, prominent but second. */
  .pub-head { margin-bottom: clamp(22px, 2.6vw, 32px); }
  .pub-title {
    margin: 0;
    font-size: clamp(1.75rem, 1.15rem + 1.9vw, 2.75rem);
    line-height: 1.1;
    letter-spacing: -0.028em;
    font-weight: 380;
    max-width: 24ch;
    text-wrap: balance;
  }
  .pub-name { font-weight: 550; }
  .nw { white-space: nowrap; }
  .authors { margin-top: 14px; color: var(--ink-2); max-width: 72ch; }
  .authors strong { font-weight: 550; color: var(--ink); }
  .venue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 16px;
  }
  .venue-badge {
    display: inline-block;
    padding: 5px 12px 6px;
    background: var(--accent);
    color: var(--plate);
    font-size: var(--step-0);
    font-weight: 550;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  .venue-track { color: var(--ink-2); font-size: var(--step-0); letter-spacing: -0.005em; }

  /* Before and after: one 16:9 pair per example, sampled in through the page's noise. */
  .stage-fig { margin: 0; }
  .stage {
    position: relative;
    aspect-ratio: 852 / 240;
    background: var(--plate);
  }
  .stage video,
  .stage img,
  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage video,
  .stage img { object-fit: cover; }
  .stage canvas { opacity: 0; }
  .stage-fig:global(.is-gl) .stage { background: transparent; }
  .stage-fig:global(.is-gl) :is(video, img) { opacity: 0; pointer-events: none; }
  .stage-fig:global(.is-gl) canvas { opacity: 1; }

  .stage-labels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
  }
  .lbl-narrow { display: none; }

  .scenes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .scene-list { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .scene-list button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    color: var(--graphite);
    font-size: 0.9375rem;
    letter-spacing: 0.005em;
    position: relative;
    transition: color 200ms var(--ease-out);
  }
  .op { flex: none; fill: none; stroke: currentColor; stroke-width: 1.2; }
  .op-arrow { width: 14px; height: 8px; }
  .op:not(.op-arrow) { width: 9px; height: 9px; }
  .scene-list button:hover { color: var(--ink); }
  .scene-list button[aria-pressed='true'] { color: var(--ink); }
  .scene-list button[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    height: 1px;
    background: currentColor;
  }
  .scene-t {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    color: var(--graphite);
    font-size: 0.95rem;
  }
  .num {
    font-family: KaTeX_Main, 'Times New Roman', serif;
    font-size: 1.08em;
    min-width: 2.9ch;
    color: var(--graphite);
    transition: color 200ms steps(5);
  }
  .num.live { color: var(--accent); }

  /* What it is, in a sentence or two, and where to go next. */
  .pub-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px clamp(28px, 4vw, 56px);
    align-items: start;
    margin-top: clamp(22px, 2.6vw, 30px);
  }
  .summary { color: var(--ink-2); max-width: 60ch; }
  /* A short column beside the summary, so the sentence keeps its measure however many links a paper has. */
  .pub-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    min-width: 11ch;
  }
  .pub-links a { text-decoration-color: var(--rule-strong); }

  @media (max-width: 900px) {
    .pub-foot { grid-template-columns: 1fr; }
    .pub-links { flex-direction: row; flex-wrap: wrap; gap: 8px 22px; }
  }
  @media (max-width: 640px) {
    .stage { aspect-ratio: 426 / 488; }
    .stage video,
    .stage img { object-fit: contain; }
    .stage-labels { grid-template-columns: 1fr; gap: 2px; }
    .lbl-narrow { display: inline; }
  }
</style>
