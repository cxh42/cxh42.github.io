---
import katex from 'katex';
import Arrow from './Arrow.astro';
import { person, links, publications } from '../data/site';

const tLabel = katex.renderToString('t=', { throwOnError: false });
---

<section class="section" id="publications" aria-labelledby="publications-title">
  <div class="wrap section-grid">
    <div class="section-title pubs-title">
      <h2 id="publications-title">Selected Publications</h2>
      <p class="meta pubs-note">
        A selection. The full record is on <a class="arrow-link" href={links.openreview}>OpenReview<Arrow /></a>
      </p>
    </div>

    <ol class="section-body papers">
      {publications.map((pub) => {
        const first = pub.scenes?.[0];
        return (
          <li class="paper">
            <article aria-labelledby={`pub-${pub.id}`}>
              {first && (
                <figure class="vitex" data-vitex>
                  <div class="stage" data-vitex-stage>
                    <video
                      data-vitex-video
                      muted
                      playsinline
                      loop
                      preload="none"
                      poster={`/media/vitex/${first.id}.jpg`}
                      src={`/media/vitex/${first.id}.mp4`}
                      aria-label={`ViTeX-Edit-14B replacing “${first.from}” with “${first.to}”: source on the left, edited video on the right.`}
                    ></video>
                    <canvas data-vitex-canvas aria-hidden="true"></canvas>
                  </div>

                  <div class="stage-labels meta" aria-hidden="true">
                    <span><span class="lbl-narrow">Top: </span>Source, text mask in red</span>
                    <span><span class="lbl-narrow">Bottom: </span>ViTeX-Edit-14B</span>
                  </div>

                  <div class="scenes">
                    <div class="scene-list" role="group" aria-label="Choose an edit">
                      {pub.scenes.map((sc, i) => (
                        <button type="button" data-scene={sc.id} data-from={sc.from} data-to={sc.to} aria-pressed={i === 0 ? 'true' : 'false'}>
                          <span class="src">{sc.from}</span>
                          <svg viewBox="0 0 14 8" aria-hidden="true"><path d="M0 4h12.5M9.5 1l3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>
                          <span class="tgt">{sc.to}</span>
                        </button>
                      ))}
                    </div>
                    <p class="scene-t" aria-hidden="true"><span set:html={tLabel} /><span class="num" data-vitex-t>0</span></p>
                  </div>

                  <figcaption class="meta caption">
                    Outputs of ViTeX-Edit-14B on ViTeX-Bench videos, from the project page: the source video with its
                    text mask, and the edited result.
                  </figcaption>
                </figure>
              )}

              <div class="pub-text">
                <div class="pub-head">
                  <h3 class="pub-title" id={`pub-${pub.id}`}>{pub.title}</h3>
                  <p class="authors">
                    {pub.authors.map((a, i) => (<>{a === person.name ? <strong>{a}</strong> : <span>{a}</span>}{i < pub.authors.length - 1 ? ', ' : ''}</>))}
                  </p>
                  <p class="venue">
                    <span class="venue-name">{pub.venue}</span>
                    <span class="venue-track">{pub.track}</span>
                  </p>
                </div>
                <div class="pub-detail">
                  <p class="summary">{pub.summary}</p>
                  <ul class="pub-links">
                    {pub.links.map((l) => (
                      <li>
                        <a class="arrow-link" href={l.href}>
                          {l.label}
                          <Arrow />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .pubs-title h2 { font: inherit; letter-spacing: inherit; }
  .pubs-note { margin-top: 14px; max-width: 18rem; font-size: var(--step--1); letter-spacing: 0.01em; }
  .pubs-note a { color: var(--ink-2); }

  /* Each paper is its own unit: a tinted plate with room around it, so the next one reads as a new project. */
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(16px, 2vw, 24px);
  }
  .paper {
    background: var(--plate-2);
    padding: clamp(16px, 2.6vw, 36px);
  }

  .vitex { margin: 0; }
  .stage {
    position: relative;
    aspect-ratio: 852 / 240;
    background: var(--plate);
  }
  .stage video,
  .stage canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage video { object-fit: cover; }
  .stage canvas { opacity: 0; }
  :global(html.vitex-gl) .stage { background: transparent; }
  :global(html.vitex-gl) .stage video { opacity: 0; pointer-events: none; }
  :global(html.vitex-gl) .stage canvas { opacity: 1; }

  .stage-labels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
  }
  .lbl-narrow { display: none; }

  .scenes {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    flex-wrap: wrap;
    margin-top: 20px;
    padding-block: 14px;
    border-block: 1px solid var(--rule);
  }
  .scene-list { display: flex; flex-wrap: wrap; gap: 6px 22px; }
  .scene-list button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: 0;
    padding: 6px 0;
    cursor: pointer;
    color: var(--graphite);
    font-size: 0.9375rem;
    letter-spacing: 0.005em;
    position: relative;
    transition: color 200ms var(--ease-out);
  }
  .scene-list button svg { width: 14px; height: 8px; flex: none; }
  .scene-list button:hover { color: var(--ink); }
  .scene-list button[aria-pressed='true'] { color: var(--ink); }
  .scene-list button[aria-pressed='true']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1px;
    height: 1px;
    background: currentColor;
  }
  .scene-t {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    color: var(--graphite);
    font-size: 0.95rem;
  }
  .num {
    font-family: KaTeX_Main, 'Times New Roman', serif;
    font-size: 1.08em;
    min-width: 2.9ch;
    color: var(--graphite);
    transition: color 200ms steps(5);
  }
  .num.live { color: var(--accent); }
  .caption { margin-top: 14px; max-width: 60ch; }

  .pub-text {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 28px clamp(28px, 4vw, 64px);
    margin-top: clamp(40px, 5vw, 64px);
  }
  .venue {
    margin-top: 12px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
    font-size: var(--step--1);
    letter-spacing: 0.01em;
  }
  .venue-name { font-weight: 550; color: var(--ink); }
  .venue-track { color: var(--graphite); }
  .pub-title {
    margin-top: 0;
    font-size: var(--step-2);
    line-height: 1.18;
    letter-spacing: -0.018em;
    font-weight: 400;
  }
  .authors { margin-top: 14px; color: var(--ink-2); }
  .authors strong { font-weight: 550; color: var(--ink); }
  .summary { color: var(--ink-2); max-width: var(--measure); }
  .pub-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }
  .pub-links a { text-decoration-color: var(--rule-strong); }

  @media (max-width: 900px) {
    .pub-text { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .stage { aspect-ratio: 426 / 488; }
    .stage video { object-fit: contain; }
    .stage-labels { grid-template-columns: 1fr; gap: 2px; }
    .lbl-narrow { display: inline; }
  }
</style>
