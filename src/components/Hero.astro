---
import katex from 'katex';
import { person, links } from '../data/site';

const tex = (s: string) => katex.renderToString(s, { throwOnError: false });
const equation = tex(String.raw`x_t=\sqrt{\bar{\alpha}_t}\,x_0+\sqrt{1-\bar{\alpha}_t}\,\epsilon`);
const tLabel = tex('t=');
const abLabel = tex(String.raw`\bar{\alpha}_t=`);
---

<section class="hero" id="top" data-hero>
  <canvas class="portrait" data-portrait aria-hidden="true"></canvas>
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>

  <div class="hero-inner">
    <div class="inscription" aria-hidden="true" data-inscription>
      <span class="ins-line"><span class="ins-text" lang="zh-Hans" data-ins-text>{person.cjk}</span><span class="caret" data-caret></span></span>
      <span class="ins-style" lang="zh-Hans" data-ins-style>楷书</span>
    </div>

    <h1 class="hero-name" data-hero-name>
      <span class="w" data-w>{person.given}</span>
      <span class="w" data-w>{person.family}</span>
      <span class="sr-only" lang="zh-Hans">{person.cjk}</span>
    </h1>

    <div class="hero-foot">
      <div class="lede">
        <p class="role">{person.role}</p>
        <p class="next">
          Incoming Ph.D. student in Computer Science at
          <a href={links.tamu}>Texas A&amp;M University</a>, in the
          <a href={links.taco}>TACO Group</a> advised by
          <a href={links.advisor}>Dr.&nbsp;Zhengzhong&nbsp;Tu</a>. Starting Spring&nbsp;2027.
        </p>
      </div>

      <figure class="eq" aria-label="Forward diffusion: the name above is sampled from noise.">
        <div class="eq-formula" set:html={equation} />
        <figcaption class="eq-readout" aria-hidden="true">
          <span class="eq-cell"><span set:html={tLabel} /><span class="num" data-readout-t>0</span></span>
          <span class="eq-cell"><span set:html={abLabel} /><span class="num" data-readout-ab>1.000</span></span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: max(100svh, 560px);
    display: flex;
    isolation: isolate;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  /* The particle portrait stays with the reader while it disperses, then lets go. */
  .portrait {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }
  :global(html.still) .portrait { position: absolute; }

  .hero-inner {
    position: relative;
    width: 100%;
    max-width: calc(1360px + var(--rail-space) + 2 * var(--gutter));
    margin-inline: auto;
    padding: calc(var(--header-h) + 24px) calc(var(--gutter) + var(--rail-space)) clamp(28px, 5vh, 56px) var(--gutter);
    display: grid;
    grid-template-rows: 1fr auto auto;
  }

  .hero-name {
    grid-row: 2;
    font-weight: 300;
    font-size: clamp(3.5rem, calc((min(100vw, 1360px + var(--rail-space) + 2 * var(--gutter)) - 2 * var(--gutter) - var(--rail-space)) / 6.2), 15rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 0 0 clamp(28px, 6vh, 64px) -0.05em;
    color: var(--ink);
    text-wrap: nowrap;
  }
  .w { display: inline-block; }

  /* 陈星昊 as a vertical inscription beside the portrait, the way a painter signs a scroll. */
  .inscription {
    position: absolute;
    top: calc(var(--header-h) + clamp(24px, 9vh, 104px));
    left: 42%;
    writing-mode: vertical-rl;
    display: flex;
    flex-direction: column; /* columns run right to left: the name, then its script label */
    gap: 0.7rem;
    align-items: flex-start;
    color: var(--ink);
  }
  .ins-line {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-cjk);
    font-size: clamp(2.6rem, 1.4rem + 3.2vw, 4.75rem);
    line-height: 1.12;
    letter-spacing: 0.06em;
    min-inline-size: 3.55em; /* the column keeps its length while characters are erased */
  }
  .caret {
    display: inline-block;
    inline-size: 0.07em;
    block-size: 0.9em;
    margin-inline-start: 0.1em;
    background: var(--ink);
    opacity: 0;
  }
  :global(html.typing) .caret { opacity: 1; }
  :global(html.typing) .caret.off { opacity: 0; }
  .ins-style {
    align-self: flex-end;
    font-family: var(--font-cjk);
    font-size: 0.8125rem;
    letter-spacing: 0.3em;
    color: var(--graphite);
    transition: opacity 250ms steps(6);
  }
  .ins-style.swap { opacity: 0; }

  .hero-foot {
    grid-row: 3;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px 48px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .lede { max-width: 44rem; }
  .role {
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: -0.015em;
    font-weight: 380;
  }
  .next {
    margin-top: 10px;
    color: var(--ink-2);
    max-width: 40rem;
  }

  .eq {
    margin: 0;
    text-align: right;
    color: var(--ink-2);
  }
  .eq-formula { font-size: 1.05rem; }
  .eq-readout {
    display: flex;
    justify-content: flex-end;
    gap: 20px;
    margin-top: 6px;
    color: var(--graphite);
    font-size: 0.95rem;
  }
  .eq-cell { display: inline-flex; align-items: baseline; gap: 0.25em; }
  .num {
    font-family: KaTeX_Main, 'Times New Roman', serif;
    font-size: 1.08em;
    min-width: 2.9ch;
    text-align: left;
    color: var(--graphite);
    transition: color 200ms steps(5);
  }
  .num.live { color: var(--accent); }

  /* The name is drawn by the sampler first; the DOM text takes over at t = 0. */
  :global(html.js:not(.still)) .w {
    color: transparent;
    animation: hero-safety 1ms linear 3.2s forwards;
  }
  :global(html.hero-live) .w { animation: none; }
  :global(html.hero-done) .w { color: var(--ink); animation: none; }
  :global(html.no-gl) .w { color: var(--ink); animation: none; }
  @keyframes hero-safety { to { color: var(--ink); } }

  :global(html.js:not(.still)) .inscription,
  :global(html.js:not(.still)) .hero-foot {
    opacity: 0;
    filter: blur(8px);
    animation: hero-safety-fade 1ms linear 3.2s forwards;
  }
  :global(html.hero-live) .inscription,
  :global(html.hero-live) .hero-foot { animation: none; }
  :global(html.hero-settle) .inscription,
  :global(html.hero-settle) .hero-foot,
  :global(html.no-gl) .inscription,
  :global(html.no-gl) .hero-foot {
    opacity: 1;
    filter: none;
    transition: opacity 625ms steps(15), filter 625ms steps(15);
  }
  :global(html.hero-settle) .hero-foot { transition-delay: 125ms; }
  @keyframes hero-safety-fade { to { opacity: 1; filter: none; } }

  @media (max-width: 760px) {
    .hero-name {
      font-size: calc((100vw - 2 * var(--gutter)) / 3.75);
      line-height: 0.92;
    }
    .w { display: block; }
    .inscription { left: auto; right: var(--gutter); top: calc(var(--header-h) + 3vh); }
    .ins-line { font-size: clamp(2.4rem, 11vw, 3.4rem); }
    .hero-foot { grid-template-columns: 1fr; }
    .eq { text-align: left; }
    .eq-readout { justify-content: flex-start; }
  }
</style>
