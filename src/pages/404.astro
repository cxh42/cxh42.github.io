---
// GitHub Pages serves this for any missing path, with a 404 status. The site is a single page, so a reader
// who followed a stale or mistyped link is taken straight to it.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · Xinghao Chen</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/" />
    <style>
      body { margin: 0; min-height: 100svh; display: grid; place-items: center; background: #f7f7f5; color: #101113; font: 1rem/1.5 system-ui, sans-serif; }
      a { color: inherit; }
      @media (prefers-color-scheme: dark) { body { background: #09090b; color: #e9e8e4; } }
    </style>
  </head>
  <body>
    <p>Nothing here. Going to <a href="/">the homepage</a>.</p>
  </body>
</html>
